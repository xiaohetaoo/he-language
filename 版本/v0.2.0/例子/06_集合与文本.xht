核核 ============================================
核核 06 集合运算与文本处理
核核 ============================================

核核 -- 集合的四种运算 --
甲 = 核集合([1, 2, 3, 4])
乙 = 核集合([3, 4, 5])
核说("甲：", 甲)
核说("乙：", 乙)
核说("并集：", 甲.核并集(乙))
核说("交集：", 甲.核交集(乙))
核说("差集：甲减去乙 =", 甲.核差集(乙))
核说("对称差：", 甲.核对称差(乙))

核核 -- 判断包含关系 --
核说("乙是甲的子集吗？", 乙.核是子集(甲))
核说("甲是乙的超集吗？", 甲.核是超集(乙))
核说("两者不相交吗？", 甲.核不相交(乙))

核核 -- 增删元素 --
库 = 核集合()
库.核添加("苹果")
库.核添加("香蕉")
核说("加了两种：", 库)
库.核移除("香蕉")
核说("移除香蕉后：", 库)
库.核舍弃("不存在的")         核核 舍弃不报错，移除会报错
核说("舍弃不存在的东西，没报错：", 库)

核核 -- 文本判断 --
样本 = "abc123"
核说("全是字母或数字吗？", 样本.核是字数值())
核说("全是字母吗？", 样本.核是字母())
核说("全是数字吗？", "42".核是数字())
核说("全是空白吗？", "   ".核是空白())
核说("是全小写吗？", 样本.核是小写())
核说("是全大写吗？", "ABC".核是大写())

核核 -- 文本变形 --
名 = "hello world"
核说("首字母大写：", 名.核首大写())
核说("每词首字母大写：", 名.核标题式())
核说("全大写：", 名.核上())
核说("大小写互换：", 名.核换大小())

核核 -- 对齐与填充 --
核说("左对齐 10 格：[", "左".核左齐(10), "]")
核说("右对齐 10 格：[", "右".核右齐(10), "]")
核说("居中 10 格：[", "中".核居中(10), "]")
核说("数字补零：", "42".核补零(6))

核核 -- 切分与合并 --
地址 = "省,市,区"
三段 = 地址.核三分(",")
核说("切成三段：", 三段)
核说("从右边切三段：", 地址.核右三分(","))
核说("按空格切：", "一 二 三".木亥())
核说("重新拼起来：", "-".核连接(三段))

核核 -- 查找位置 --
句子 = "甲乙甲乙甲"
核说("从左找 甲：", 句子.核找("甲"))
核说("从右找 甲：", 句子.核右找("甲"))
核说("甲 出现几次：", 句子.核数("甲"))

核核 -- 进制转换 --
数字 = 255
核说("十进制：", 数字)
核说("二进制：", 核二进(数字))
核说("八进制：", 核八进(数字))
核说("十六进制：", 核十六(数字))

核核 -- 同余与幂 --
核说("7 除以 3 的商和余：", 核除余(7, 3))
核说("2 的 10 次方：", 核乘方(2, 10))
核说("依次编号：", 核列表(核编号(["a", "b", "c"])))
