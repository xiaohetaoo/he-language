核核 ============================================
核核 03 常用容器与函数
核核 ============================================

核核 -- 列表 --
数字们 = 核列表()
核用 n 遍历 核数列(1, 6)：
    数字们.核加入(n * n)
核说("列表：", 数字们)
核说("长度：", 核长度(数字们))
核说("最大：", 核最大(数字们), "最小：", 核最小(数字们))

数字们.核排序()
核说("从小到大：", 数字们)
核说("排好的副本：", 核排好([3, 1, 2]))
核说("绝对值：", 核绝对值(-7), " 取舍：", 核取舍(3.7))

核核 -- 字符串 --
句子 = "苹果,香蕉,橙子"
部分 = 句子.木亥(",")
核说("分开后：", 部分, " 一共", 核长度(部分), "段")
核说("找 香蕉 的位置：", 句子.核找("香蕉"))
核说("数一数字数：", 句子.核数("果"))
核说("换掉苹果：", 句子.核换("苹果", "西瓜"))

核核 -- 字典与集合 --
成绩 = 核字典()
成绩["语文"] = 92
成绩["数学"] = 88
核说("成绩：", 成绩)
核说("语文：", 成绩["语文"])

去重 = 核集合([1, 1, 2, 3, 3])
核说("集合：", 去重)

核核 -- f 字符串 --
平均 = (成绩["语文"] + 成绩["数学"]) / 2
核说(核"平均分是 {平均:.1f} 分")