# 构建产物
/build/
/build_*/
/dist/
/dist_*/
*.spec

# Python 缓存
__pycache__/
*.py[cod]

# PyInstaller 中间文件（万一定义了自定义 workpath 落在此处）
*.pkg
*.pyz
*.toc

# 运行核语言时生成的未定义清单（由程序自动累积）
未定义.txt

# 本地界面配置（每台机器不同）
工坊配置.json

# 编辑器/系统
.vscode/
.idea/
Thumbs.db
desktop.ini

# 归档脚本用 --覆盖 重打同一版本号时留下的备份（本地安全网，不进仓库）
/版本/_旧_*/

# 临时目录
.dsh-office-*/
.preview-tmp/

# 截图证据：由 测试/截图证据.py 生成，默认写到 %TEMP%，
# 万一手动指到仓库里，也不要让它进版本库
/证据截图/
核工坊截图_*/
/.dsh-*/

# 本地工作笔记：不公开、不入库、不进归档
/核语言.md
/版本/*/核语言.md
